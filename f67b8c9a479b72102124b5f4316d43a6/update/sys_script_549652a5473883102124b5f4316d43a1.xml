        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Priority Matrix Logic
    var impact = parseInt(current.impact);
    var urgency = parseInt(current.urgency);
    
    if (impact == 1 && urgency == 1) current.priority = 1; // Critical
    else if (impact == 1 && urgency == 2) current.priority = 2; // High
    else if (impact == 1 && urgency == 3) current.priority = 3; // Moderate
    else if (impact == 2 && urgency == 1) current.priority = 2; // High
    else if (impact == 2 && urgency == 2) current.priority = 3; // Moderate
    else if (impact == 2 && urgency == 3) current.priority = 4; // Low
    else if (impact == 3 && urgency == 1) current.priority = 3; // Moderate
    else if (impact == 3 && urgency == 2) current.priority = 4; // Low
    else if (impact == 3 && urgency == 3) current.priority = 5; // Planning
})(current, previous);]]></script>
